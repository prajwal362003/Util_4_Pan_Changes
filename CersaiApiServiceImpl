	private static Document convertStringToXMLDoc(String strXMLValue) {
		try {
			return DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(strXMLValue)));
		} catch (Exception e) {
			e.printStackTrace();
		}
		return null;
	}


