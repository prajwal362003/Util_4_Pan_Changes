	//decode PID from base64 then decrypt data using session key
	public byte[] decrypt(byte[] strToDecode, byte[] sessionKey){
		try {
			SecretKeySpec secKey = new SecretKeySpec(sessionKey,"AES");
			Cipher cipher = Cipher.getInstance("AES/ECB/PKCS5Padding");
			cipher.init(Cipher.DECRYPT_MODE, secKey);
			byte[] original = cipher.doFinal(Base64.decodeBase64(strToDecode));
			return original;
		} catch (Exception e) {
			e.printStackTrace();
		} 
		return strToDecode;
	}

	//encrypt data using session key and then encode it in base64
	public byte[] encryptUsingSessionKey(byte[] strToEncrypt, byte[] sessionKey, boolean otherChannelFlag){
		try {
			PaddedBufferedBlockCipher cipher;
			if(otherChannelFlag){
				cipher = new PaddedBufferedBlockCipher(
						new CBCBlockCipher(new  AESEngine()), new PKCS7Padding());
			}else{
				cipher = new PaddedBufferedBlockCipher(new AESEngine(), new PKCS7Padding());
			}
			cipher.init(true, new KeyParameter(sessionKey));
			int outputSize = cipher.getOutputSize(strToEncrypt.length);

			byte[] tempOP = new byte[outputSize];
			int processLen = cipher.processBytes(strToEncrypt, 0, strToEncrypt.length, tempOP, 0);
			int outputLen = cipher.doFinal(tempOP, processLen);

			byte[] result = new byte[processLen + outputLen];
			System.arraycopy(tempOP, 0, result, 0, result.length);
			if(otherChannelFlag){
				return Base64.encodeBase64(result);
			}else{
				return result;
			}
		} catch (Exception e) {
			//					logger.info("Exception occurred ::::: " +e.getMessage());
			e.getMessage();
		} 
		return null;
	}

	//decode PID from base64 then decrypt data using session key
	public byte[] decryptUsingSessionKey(byte[] strToDecode, byte[] sessionKey, boolean decodeFlag){
		try {
			PaddedBufferedBlockCipher cipher;
			byte[] result; 
			if(decodeFlag){
				cipher = new PaddedBufferedBlockCipher(
						new CBCBlockCipher(new  AESEngine()), new PKCS7Padding());
				strToDecode = Base64.decodeBase64(strToDecode);
			}else{
				cipher = new PaddedBufferedBlockCipher(new AESEngine(), new PKCS7Padding());
			}
			cipher.init(false, new KeyParameter(sessionKey));
			int outputSize = cipher.getOutputSize(strToDecode.length);
			byte[] tempOP = new byte[outputSize];
			int processLen = cipher.processBytes(strToDecode, 0, strToDecode.length, tempOP, 0);
			int outputLen = cipher.doFinal(tempOP, processLen);
			result = new byte[processLen + outputLen];
			System.arraycopy(tempOP, 0, result, 0, result.length);
			return result;
		} catch (Exception e) {
			logger.info("Exception occurred ::::: " +e.getMessage());
		} 
		return strToDecode;
	}

