	//AES Encrypt data in GCM Mode with NoPadding
	public  byte[] encryptgcm(byte[] data, SecretKey sk, byte[] IV){
		// Get Cipher Instance
		Cipher cipher = null;
		try {
			cipher = Cipher.getInstance("AES/GCM/NoPadding");
		} catch (NoSuchAlgorithmException | NoSuchPaddingException e) {

			e.printStackTrace();
		}

		// Create SecretKeySpec
		SecretKeySpec keySpec = new SecretKeySpec(sk.getEncoded(), "AES");

		// Create GCMParameterSpec
		GCMParameterSpec gcmParameterSpec = new GCMParameterSpec(16 * 8, IV);

		System.out.println("Length gcm Parameter spec>> "+gcmParameterSpec.getTLen());
		// Initialize Cipher for ENCRYPT_MODE
		try {
			cipher.init(Cipher.ENCRYPT_MODE, keySpec, gcmParameterSpec);
		} catch (InvalidKeyException | InvalidAlgorithmParameterException e) {

			e.printStackTrace();
		}

		// Perform Encryption
		byte[] cipherText = null;
		try {
			//				cipherText = cipher.doFinal("Thsi is message".getBytes());
			cipherText = cipher.doFinal(data);
		} catch (IllegalBlockSizeException | BadPaddingException e) {

			e.printStackTrace();
		}

		byte[] cipherTextWithIv = ByteBuffer.allocate(IV.length + cipherText.length)
				.put(IV)
				.put(cipherText)
				.array();
		return cipherTextWithIv;

	}

