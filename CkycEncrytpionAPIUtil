	public KeyStore.PrivateKeyEntry getKeyFromKeyStoreTest(char[] keyStorePassword, String alias)
	{
		FileInputStream keyFileStream = null;
		try {
			KeyStore ks = KeyStore.getInstance("PKCS12");
			//		      keyFileStream = new FileInputStream("D:\\Rajeshwari\\CKYCAPI_SA\\API_CLIENT\\cersai-download-ws-c-sav1\\src\\resources\\CKYC_UAT_Signed.pfx");
			// keyFileStream = new FileInputStream("D:\\\\\\\\BHAKTI\\\\\\\\CERTIFICATE\\\\\\\\CKYC_UAT_Signed.pfx");
			keyFileStream = new FileInputStream( EnqCKYCKeyStorePath);

			ks.load(keyFileStream, keyStorePassword);
			if (alias == null)
			{
				Enumeration alias1 = ks.aliases();
				if (ks.size() > 1)
				{
					throw new Exception("More that 1 Keys found in the key store. Please specify Key Alias property!");
				}

				alias1.hasMoreElements();
				alias = (String)alias1.nextElement();
			}
			KeyStore.PrivateKeyEntry entry = (KeyStore.PrivateKeyEntry)ks.getEntry(alias, 
					new KeyStore.PasswordProtection(keyStorePassword));
			KeyStore.PrivateKeyEntry localPrivateKeyEntry1 = entry;
			return localPrivateKeyEntry1;
		}
		catch (Exception e) {
			logger.info("Exception occurred ::::: " +e.getMessage());
			return null;
		} finally {
			if (keyFileStream != null)
				try {
					keyFileStream.close();
				} catch (IOException e) {
					logger.info("Exception occurred ::::: " +e.getMessage());
				}
		}

	}

	//AES Decrypt data in GCM Mode with NoPadding
	public static String decryptgcm(byte[] cipherText, SecretKey key) throws Exception
	{
		// Get Cipher Instance
		Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");

		// Create SecretKeySpec
		SecretKeySpec keySpec = new SecretKeySpec(key.getEncoded(), "AES");

		ByteBuffer bb = ByteBuffer.wrap(cipherText);

		byte[] iv = new byte[12];
		bb.get(iv);
		//bb.get(iv, 0, iv.length);

		cipherText = new byte[bb.remaining()];
		bb.get(cipherText);
		// Create GCMParameterSpec
		GCMParameterSpec gcmParameterSpec = new GCMParameterSpec(16 * 8, iv);

		// Initialize Cipher for DECRYPT_MODE
		cipher.init(Cipher.DECRYPT_MODE, keySpec, gcmParameterSpec);

		// Perform Decryption
		byte[] decryptedText = cipher.doFinal(cipherText);

		return new String(decryptedText);
	}

	//encrypt the session key with of CERSEI's public key and convert it into base64
	public byte[] encryptClientSessionKey(byte[] data, String version, String channelId,String channelPublicKeyPath) throws IOException, GeneralSecurityException {
		Cipher pkCipher = null;
		Provider bcProvider = new BouncyCastleProvider();
		//pkCipher = Cipher.getInstance("RSA/ECB/OAEPWithSHA256AndMGF1Padding");
		//pkCipher = Cipher.getInstance("RSA/ECB/OAEPWithSHA256AndMGF1Padding");
		pkCipher = Cipher.getInstance("RSA/NONE/OAEPWithSHA256AndMGF1Padding", bcProvider);
		logger.info("pkCipher :: "+pkCipher);

		PublicKey publicKeyClient; 
		InputStream isClient=  null;
		try {
			CertificateFactory certFactory = CertificateFactory.getInstance("X.509");
			/*For Local*/
			isClient=new FileInputStream(new File(channelPublicKeyPath+channelId+"_publicKey.cer"));
			/*For WAS*/
			//					isClient=new FileInputStream(new File(channelPublicKeyPath+channelId+"/"+channelId+"_publicKey.cer"));
			X509Certificate cert = (X509Certificate) certFactory.generateCertificate(isClient);
			publicKeyClient = cert.getPublicKey();

		} catch (Exception e) {
			logger.info("Exception occurred ::::: " +e.getMessage());
			throw new RuntimeException("Could not intialize encryption module", e);
		} finally {
			if(isClient != null){
				try {
					isClient.close();
				} catch (IOException e) {
					logger.info("Exception occurred ::::: " +e.getMessage());
				}	
			}
		}
		pkCipher.init(Cipher.ENCRYPT_MODE, publicKeyClient);
		byte[] encSessionKey = pkCipher.doFinal(data);
		return encSessionKey;
	}




