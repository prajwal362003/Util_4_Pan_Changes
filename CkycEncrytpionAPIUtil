	//encrypt data using session key and then encode it in base64
	public String encryptUsingAESToBase64(byte[] strToEncrypt, byte[] sessionKey){
		try {
			SecretKeySpec secKey = new SecretKeySpec(sessionKey,"AES");
			Cipher cipher = Cipher.getInstance("AES/ECB/PKCS5Padding");
			cipher.init(Cipher.ENCRYPT_MODE, secKey);
			byte[] encrypted = cipher.doFinal(strToEncrypt);
			return new String(Base64.encodeBase64(encrypted));

		} catch (Exception e) {
			e.printStackTrace();
		} 
		return null;
	}

