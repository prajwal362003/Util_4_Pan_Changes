	public byte[] encryptUsingCKYCPublicKey(byte[] data, String version) throws IOException, GeneralSecurityException {
		Cipher pkCipher = Cipher.getInstance("RSA/ECB/OAEPPadding"); 
		OAEPParameterSpec oaepParams = new OAEPParameterSpec(
				"SHA-256", 
				"MGF1", 
				new MGF1ParameterSpec("SHA-256"), 
				PSource.PSpecified.DEFAULT
				);
		pkCipher.init(Cipher.ENCRYPT_MODE, this.publicKey, oaepParams);
		return pkCipher.doFinal(data);
	}


