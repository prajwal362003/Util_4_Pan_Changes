	// 'uu' = 2-digit year, 'DDD' = 3-digit day of year (001-366)
	private static final DateTimeFormatter DATE_PART_FORMATTER = DateTimeFormatter.ofPattern("uuDDD");
	// Formatter for time components: HH (00-23), mm (00-59), ss (00-59), SSS (000-999)
	private static final DateTimeFormatter TIME_PART_FORMATTER = DateTimeFormatter.ofPattern("HHmmssSSS");
	public String generateReqRefNo1() {
		LocalDateTime now = LocalDateTime.now();
		String datePart = now.format(DATE_PART_FORMATTER);//Generate Date Part: 2-digit Year + 3-digit Day of Year (e.g., "26195" for 2026, 195th day)
		String timePart = now.format(TIME_PART_FORMATTER);//Generate Time Part: HHmmssSSS (Always 9 digits due to formatter)
		String randomKey = generateSecureNumeric(6);//Generate 6-digit Random Numeric Key
		StringBuilder sb = new StringBuilder(24); // allocate capacity: 5(SBICK) + 5(date) + 9(time) + 6(random)
		sb.append("SBICK");
		sb.append(datePart);
		sb.append(timePart);
		sb.append(randomKey);
		String result = sb.toString();
		logger.info("Generated RRN: " + result);
		logger.info("RRN Size: " + result.length());
		return result;
	}

	private String generateSecureNumeric(int length) {
		StringBuilder randomSb = new StringBuilder(length);
		ThreadLocalRandom random = ThreadLocalRandom.current();
		for (int i = 0; i < length; i++) {
			randomSb.append(random.nextInt(0, 10));
		}
		return randomSb.toString();
	}


